# application
APP_NAME=Management
ENV=local
DEBUG=true
APP_BASE_URL=http://localhost:8000

AWS_REGION=us-east-1
# AWS_SECRETS_NAME=management/prod
SENDER_EMAIL=no-reply@yourdomain.com

# Sentry, off without a DSN
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Run "alembic upgrade head" on container start (set false to disable)
RUN_MIGRATIONS=true

# database
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/management_db

# Connection pool 
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_ECHO=false
DB_SSL=disable

# security and authentication
SECRET_KEY=your-secret-key-here-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_SCHEME=argon2

# server
UVICORN_WORKERS=1
GUNICORN_WORKERS=2

# assistant (LLM). In prod the key lives in Secrets Manager.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_MAX_TOKENS=8000
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=25
ASSISTANT_MAX_ITERATIONS=5
ASSISTANT_DEADLINE_SECONDS=50
ASSISTANT_MAX_COST_PER_REQUEST=200000
ASSISTANT_DAILY_COST_PER_USER=2500000

# CORS (list values must be valid JSON arrays)
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
